{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "crm",
      "public": "site",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
